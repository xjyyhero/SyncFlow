# Local V1.0 only. Never commit .env or real credentials.
# Container addresses; keep service names for Docker Compose.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=syncflow
MYSQL_USER=syncflow
MYSQL_PASSWORD=syncflow123
REDIS_ADDR=redis:6379
REDIS_JOB_QUEUE=syncflow:jobs

# Upload/CSV limits shared by API and Worker: MiB and nonblank data records.
# Invalid data rows count toward MAX_RECORDS_PER_JOB.
MAX_UPLOAD_FILE_SIZE_MB=10
MAX_RECORDS_PER_JOB=10000
# Compose fixes this path for both services; Worker mounts it read-only.
UPLOAD_DIR=/app/uploads
# Compose stop grace period; the current Worker processes one job at a time.
WORKER_SHUTDOWN_TIMEOUT_SECONDS=30

# Host ports only. Change these to run an isolated Compose project alongside dev.
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379
API_HOST_PORT=8000
WEB_HOST_PORT=5173

# Reserved for future versions: NOT enforced by the V1.0 Worker/API.
WORKER_CONCURRENCY=2
JOB_TIMEOUT_SECONDS=300
MAX_JOB_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=5,30,120
IDEMPOTENCY_KEY_TTL_HOURS=24
