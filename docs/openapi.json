                    "code": "VALIDATION_ERROR",
                    "message": "请求无法完成",
                    "details": []
                  }
                }
              }
            }
          },
          "503": {
            "description": "SERVICE_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "SERVICE_UNAVAILABLE",
                    "message": "请求无法完成",
                    "details": []
                  }
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR",
            "content": {
