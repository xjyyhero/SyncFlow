    "/api/v1/jobs/{job_id}/export": {
      "parameters": [
        {
          "name": "job_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "operationId": "exportJob",
        "summary": "计划 V1.1 导出终态任务结果",
        "description": "终态（包括FAILED/CANCELLED）可导出已提交记录。UTF-8 CSV 流式下载，文件响应不使用 JSON 包裹。records列为external_id,name,amount,record_date；errors列为row_number,code,message,field。电子表格危险文本前缀进行安全转义。",
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "records",
                "errors"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "CSV 文件；没有记录时只有表头。",
            "headers": {
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                },
                "description": "attachment; filename=\"records.csv\" 或 errors.csv"
              }
            },
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "JOB_NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "JOB_NOT_FOUND",
                    "message": "请求无法完成",
                    "details": []
                  }
                }
              }
            }
          },
          "409": {
            "description": "JOB_NOT_FINISHED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "JOB_NOT_FINISHED",
                    "message": "请求无法完成",
                    "details": []
                  }
                }
              }
            }
          },
          "422": {
            "description": "VALIDATION_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "VALIDATION_ERROR",
                    "message": "请求无法完成",
                    "details": []
                  }
                }
              }
            }
          },
          "503": {
            "description": "SERVICE_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
