    "/api/v1/jobs/{job_id}/cancel": {
      "parameters": [
        {
          "name": "job_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "operationId": "cancelJob",
        "summary": "计划 V1.1 取消任务",
        "description": "QUEUED/RETRY_WAIT 立即取消200；RUNNING设置标记返回202；已CANCELLED返回200；其他终态409。",
        "responses": {
          "200": {
            "description": "已经取消",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResponse"
                }
              }
            }
          },
          "202": {
            "description": "已请求取消，等待批次边界",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResponse"
                }
              }
            }
          },
          "404": {
            "description": "JOB_NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "JOB_NOT_FOUND",
                    "message": "请求无法完成",
                    "details": []
                  }
                }
              }
            }
          },
          "409": {
            "description": "JOB_NOT_CANCELLABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "JOB_NOT_CANCELLABLE",
                    "message": "请求无法完成",
                    "details": []
                  }
                }
              }
            }
          },
          "422": {
            "description": "VALIDATION_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
