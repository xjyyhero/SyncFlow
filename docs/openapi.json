{
  "openapi": "3.0.3",
  "info": {
    "title": "SyncFlow API 设计提案",
    "version": "0.1.0-design",
    "description": "Week 1 评审契约；仅 /healthz 和 /api/v1/info 已实现，其他接口计划实现。JSON业务成功用data/meta，失败用error；健康检查及CSV下载为显式例外。日期时间UTC，业务日期不带时区。"
  },
  "servers": [
    {
      "url": "http://localhost:8000"
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthz",
        "summary": "已实现：进程存活检查，不访问 MySQL/Redis",
        "responses": {
          "200": {
            "description": "API 进程可响应",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/info": {
      "get": {
        "operationId": "projectInfo",
        "summary": "已实现：项目骨架信息",
        "responses": {
          "200": {
            "description": "项目名称和阶段",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Info"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs": {
      "post": {
        "operationId": "createJob",
        "summary": "计划 V1.0 创建任务；V1.1 支持幂等键",
        "description": "流式文件预检后保存文件及 QUEUED 任务，202 不等待 Worker。multipart 上限按文件字节10 MiB计算；最多10000个非空数据记录。业务规则为待审核提案。",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "V1.1 可选 ASCII 可见字符键，TTL 24h；同键同摘要重放200，冲突409。",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[!-~]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "required": [
                  "file"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "新任务已持久化，可能等待队列补投",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResponse"
                }
              }
            }
          },
          "200": {
            "description": "V1.1 幂等重放原任务",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResponse"
                }
              }
            }
          },
          "413": {
            "description": "FILE_TOO_LARGE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "FILE_TOO_LARGE",
                    "message": "请求无法完成",
                    "details": []
                  }
                }
              }
            }
          },
          "415": {
            "description": "UNSUPPORTED_MEDIA_TYPE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "UNSUPPORTED_MEDIA_TYPE",
                    "message": "请求无法完成",
                    "details": []
                  }
                }
              }
            }
          },
          "422": {
            "description": "VALIDATION_ERROR, EMPTY_FILE, INVALID_HEADER, INVALID_CSV, INVALID_ENCODING, TOO_MANY_RECORDS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "VALIDATION_ERROR",
                    "message": "请求无法完成",
                    "details": []
                  }
                }
              }
            }
          },
          "409": {
            "description": "IDEMPOTENCY_CONFLICT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "IDEMPOTENCY_CONFLICT",
                    "message": "请求无法完成",
                    "details": []
                  }
                }
              }
            }
          },
          "503": {
            "description": "SERVICE_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "SERVICE_UNAVAILABLE",
                    "message": "请求无法完成",
                    "details": []
                  }
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "INTERNAL_ERROR",
                    "message": "请求无法完成",
                    "details": []
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listJobs",
        "summary": "计划 V1.0 分页查询任务",
        "description": "按 created_at DESC,job_id DESC 排序。",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/Status"
            }
