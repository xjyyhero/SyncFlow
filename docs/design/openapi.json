  "paths": {
    "/healthz": {
      "get": {
        "summary": "Healthz",
        "description": "Report process liveness without checking database or queue availability.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "INVALID_REQUEST": {
                    "value": {
                      "error": {
                        "code": "INVALID_REQUEST",
                        "message": "请求参数不合法",
                        "details": []
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "INTERNAL_ERROR": {
                    "value": {
                      "error": {
                        "code": "INTERNAL_ERROR",
                        "message": "服务内部错误，请稍后重试",
                        "details": []
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
